        android:fillColor="#0D0D0F"
        android:pathData="M0,0h320v180h-320z" />

    <!-- Akzent-Linie oben -->
    <path
        android:fillColor="#6C5CE7"
        android:pathData="M0,0h320v4h-320z" />

    <!-- NovaStream Logo Text -->
    <group
        android:translateX="40"
        android:translateY="70">
        <!-- N Symbol -->
        <path
