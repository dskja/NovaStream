    </group>

    <!-- "NovaStream" Text -->
    <group
        android:translateX="90"
        android:translateY="78">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.95"
            android:pathData="M0,8 L4,8 L4,2 Q4,0 6,0 L14,0 L14,4 L8,4 L8,8 L14,8 L14,12 L8,12 L8,18 L14,18 L14,22 L6,22 Q4,22 4,20 L4,12 L0,12 Z" />
    </group>

    <!-- Untertitel -->
    <path
        android:fillColor="#A29BFE"
        android:fillAlpha="0.7"
        android:pathData="M40,130 L260,130 L260,134 L40,134 Z" />

    <!-- Play Icon -->
    <group
        android:translateX="260"
        android:translateY="70">
        <path
            android:fillColor="#6C5CE7"
            android:pathData="M0,0 L0,40 L32,20 Z" />
    </group>
</vector>
